{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LIFE Compute Cancer Target",
  "description": "Schema for a cancer drug discovery target in the LIFE Compute network",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id","uniprot_id","protein_name","protein_sequence","disease_context",
                 "difficulty_tier","difficulty_rationale","known_drugs",
                 "scoring_metric","target_score_threshold","pdb_id","active_site_residues"],
    "properties": {
      "id":                    {"type":"string","description":"Short gene/protein identifier (e.g. TP53)"},
      "uniprot_id":            {"type":"string","pattern":"^[A-Z][0-9][A-Z0-9]{3}[0-9]$","description":"UniProt accession"},
      "protein_name":          {"type":"string","description":"Full IUPAC/UniProt protein name"},
      "protein_sequence":      {"type":"string","minLength":50,"description":"Canonical UniProt amino-acid sequence (single-letter code)"},
      "disease_context":       {"type":"string","description":"Role in cancer biology"},
      "difficulty_tier":       {"type":"integer","minimum":1,"maximum":3,"description":"1=tractable, 2=moderate, 3=challenging"},
      "difficulty_rationale":  {"type":"string","description":"Structural/biological reason for the tier assignment"},
      "known_drugs": {
        "type":"array","minItems":1,
        "items": {
          "type":"object",
          "required":["name","mechanism"],
          "properties": {
            "name":          {"type":"string"},
            "mechanism":     {"type":"string"},
            "approved_year": {"type":["integer","null"]}
          }
        }
      },
      "scoring_metric":          {"type":"string","enum":["binding_affinity_kcal_mol","docking_score"]},
      "target_score_threshold":  {"type":"number","description":"Score threshold for a hit (lower = stronger binding for kcal/mol)"},
      "pdb_id":                  {"type":"string","pattern":"^[0-9][A-Z0-9]{3}$","description":"RCSB PDB structure ID"},
      "active_site_residues":    {"type":"array","items":{"type":"integer"},"minItems":1,"description":"Key residue positions for docking"}
    },
    "additionalProperties": false
  }
}
