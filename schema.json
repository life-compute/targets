{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LIFE Compute Cancer Target",
  "description": "Schema for a cancer drug discovery target in the LIFE Compute network. Supports both protein targets (type=protein, default) and mRNA targets (type=mRNA).",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "title": "Protein target",
        "type": "object",
        "required": ["id","uniprot_id","protein_name","protein_sequence","disease_context",
                     "difficulty_tier","difficulty_rationale","known_drugs",
                     "scoring_metric","target_score_threshold","pdb_id","active_site_residues"],
        "properties": {
          "id":                    {"type":"string","description":"Short gene/protein identifier (e.g. TP53)"},
          "target_type":           {"type":"string","enum":["protein"]},
          "uniprot_id":            {"type":"string","pattern":"^[A-Z][0-9][A-Z0-9]{3}[0-9]$"},
          "protein_name":          {"type":"string"},
          "protein_sequence":      {"type":"string","minLength":50,"description":"Canonical UniProt amino-acid sequence"},
          "disease_context":       {"type":"string"},
          "difficulty_tier":       {"type":"integer","minimum":1,"maximum":3},
          "difficulty_rationale":  {"type":"string"},
          "known_drugs": {
            "type":"array","minItems":1,
            "items": {
              "type":"object",
              "required":["name","mechanism"],
              "properties": {
                "name":          {"type":"string"},
                "mechanism":     {"type":"string"},
                "approved_year": {"type":["integer","null"]}
              }
            }
          },
          "scoring_metric":          {"type":"string","enum":["binding_affinity_kcal_mol","docking_score"]},
          "target_score_threshold":  {"type":"number"},
          "pdb_id":                  {"type":["string","null"],"pattern":"^[0-9][A-Z0-9]{3}$"},
          "active_site_residues":    {"type":"array","items":{"type":"integer"},"minItems":1}
        },
        "additionalProperties": false,
        "if": {"not": {"required": ["target_type"]}},
        "then": {}
      },
      {
        "title": "mRNA target",
        "type": "object",
        "required": ["id","target_type","uniprot_id","protein_name","rna_sequence",
                     "mrna_region","disease_context","difficulty_tier","difficulty_rationale",
                     "known_binders","known_drugs","scoring_metric","target_score_threshold",
                     "pdb_id","active_site_residues"],
        "properties": {
          "id":                    {"type":"string","pattern":"_mRNA$","description":"mRNA target ID, must end with _mRNA"},
          "target_type":           {"type":"string","enum":["mRNA"]},
          "uniprot_id":            {"type":"string","pattern":"^[A-Z][0-9][A-Z0-9]{3}[0-9]$","description":"UniProt AC of encoded protein"},
          "protein_name":          {"type":"string","description":"Encoded protein name (for MSA reference)"},
          "rna_sequence":          {"type":"string","minLength":50,"description":"60-nt representative mRNA segment of the targeted region (CDS/UTR)"},
          "mrna_region":           {"type":"string","description":"Which mRNA structural element is targeted"},
          "disease_context":       {"type":"string"},
          "difficulty_tier":       {"type":"integer","minimum":3,"maximum":3,"description":"Always 3 (HARD) — mRNA targeting is frontier science"},
          "difficulty_rationale":  {"type":"string"},
          "known_binders":         {"type":"array","items":{"type":"string"},"description":"Known small molecules that bind this RNA structure"},
          "known_drugs":           {"type":"array","items":{"type":"object"},"description":"Approved/clinical drugs (empty array permitted for novel RNA targets)"},
          "scoring_metric":        {"type":"string","enum":["binding_affinity_kcal_mol","docking_score"]},
          "target_score_threshold":{"type":"number"},
          "pdb_id":                {"type":"null","description":"null for mRNA targets (use rna_sequence for structure prediction)"},
          "active_site_residues":  {"type":"array","items":{"type":"integer"},"description":"Empty for mRNA targets"}
        },
        "additionalProperties": false
      }
    ]
  }
}
